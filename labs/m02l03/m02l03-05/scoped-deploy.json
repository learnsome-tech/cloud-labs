{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishSiteBundle",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::site-bundles-prod/*"
    },
    {
      "Sid": "NoBucketSurgery",
      "Effect": "Deny",
      "Action": ["s3:DeleteBucket", "s3:PutBucketPolicy"],
      "Resource": "*"
    }
  ]
}
