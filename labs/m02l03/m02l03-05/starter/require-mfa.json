{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProdSecretsWithMfa",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:eu-west-2:123456789012:secret:prod-*",
      "Condition": {
        "Bool": { "aws:MultiFactorAuthPresent": "true" }
      }
    }
  ]
}
