{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RotateKeysWithMfaOnly",
      "Effect": "Allow",
      "Action": "iam:CreateAccessKey",
      "Resource": "arn:aws:iam::123456789012:user/deploy",
      "Condition": {
        "Bool": { "aws:MultiFactorAuthPresent": "true" }
      }
    }
  ]
}
